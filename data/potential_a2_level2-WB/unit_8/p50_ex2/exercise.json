{"mode":"training","language":"en","altTextLanguage":"","title":"","instruction":{"english":"","german":""},"allowInstructionLineBreaks":false,"readingText":{"instruction":{"german":"","english":""},"content":"","configs":[]},"sequences":[{"instruction":{"german":"<p>Complete the conversation with these words.<\/p>","english":""},"configs":[{"correctAnswer":"won't","additionalAnswers":[],"id":"gap_0","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"don't","additionalAnswers":[],"id":"gap_1","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"stressed","additionalAnswers":[],"id":"gap_2","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"a stomach ache","additionalAnswers":[],"id":"gap_3","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"shouldn't","additionalAnswers":[],"id":"gap_4","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"should","additionalAnswers":[],"id":"gap_5","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"heart","additionalAnswers":[],"id":"gap_6","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"},{"correctAnswer":"brain","additionalAnswers":[],"id":"gap_7","type":"gap","exerciseUrl":"https:\/\/exercise-editor.helbling.com\/files\/potential_a2\/WB\/unit_8\/p50_ex2\/"}],"staticConfigs":[],"parts":["<p><b>Lisa:<\/b> Are you OK?<\/p><p><b>Dave:<\/b> Not really. I have a headache. I have too much homework. I've got exams soon.<\/p><p>If I don\u2019t study, I <sup>1<\/sup> <gap id=\"gap_0\"><\/gap> pass! I feel worried about it!<\/p><p><b>Lisa:<\/b> Oh no.<\/p><p><b>Dave:<\/b> And I\u2019m worried about my summer job application. If I <sup>2<\/sup> <gap id=\"gap_1\"><\/gap> get the job, I\u2019ll feel really sad!<\/p><p><b>Lisa:<\/b> I\u2019m sorry to hear that! If I feel <sup>3<\/sup> <gap id=\"gap_2\"><\/gap>, I go running. It always makes me feel better! You should try it!<\/p><p><b>Dave:<\/b> After I go running, I usually have <sup>4<\/sup> <gap id=\"gap_3\"><\/gap>. I went running after breakfast last week, and I felt sick.<\/p><p><b>Lisa:<\/b> You probably <sup>5<\/sup> <gap id=\"gap_4\"><\/gap> eat before you go running. You <sup>6<\/sup> <gap id=\"gap_5\"><\/gap> wait a few hours.<\/p><p><b>Dave:<\/b> Maybe. I really need to study. Will running help me <em>think<\/em> better?<\/p><p><b>Lisa:<\/b> Yes, it will! If you run, your <sup>7<\/sup> <gap id=\"gap_6\"><\/gap> beats faster. Then you get more blood to your <sup>8<\/sup> <gap id=\"gap_7\"><\/gap>! And then you think better! It also helps with stress.<\/p><p><b>Dave:<\/b> Really?<\/p><p><b>Lisa:<\/b> Yes! I read about it in an exercise magazine.<\/p><p><b>Dave:<\/b> I\u2019ll read the article if you let me borrow the magazine.<\/p><p><b>Lisa:<\/b> Sure, no problem.<\/p>"],"globalTypesConfigs":[{"type":"gap","widthMode":"asLongestWord","longestAlternativeSolutions":false,"ignoreCaseSensitivity":false}],"wordbox":{"interactive":true,"distractors":[],"backgroundColor":"lightgray","textAlign":"center","fontColor":"black"}}]}